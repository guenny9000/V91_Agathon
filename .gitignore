# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*.pyo

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test and coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# Secrets / keys – never commit these
secrets/
*.key
*.pem
.env
.env.*
!.env.example

# Audit artefacts that belong outside the repo
audits/*.jsonl

# Logs
logs/
*.log

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db

# Local snapshot diffs (reviewed, not committed)
.snapshots/